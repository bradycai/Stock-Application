# ---- Database ----
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/trading_assistant

# ---- Claude ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Model routing: one model + effort per layer (effort: low | medium | high | xhigh | max).
# strategist = trade analysis; position = monitor/position decisions (blank = strategist model).
STRATEGIST_MODEL=claude-opus-5-5
STRATEGIST_EFFORT=high
POSITION_MODEL=
POSITION_EFFORT=medium
RESEARCH_MODEL=claude-sonnet-5-5
RESEARCH_EFFORT=medium
WATCHER_MODEL=claude-haiku-5-5
WATCHER_EFFORT=low
# ---- Strategist worker (python -m app.workers.strategist_worker) ----
# Off by default. Sends each ready research bundle to STRATEGIST_MODEL (Opus); accepted
# proposals become PENDING trade intents that still need approval (never executed here).
STRATEGIST_WORKER_ENABLED=false
STRATEGIST_POLL_SECONDS=30
STRATEGIST_LEASE_SECONDS=900
STRATEGIST_DAILY_BUDGET_USD=5
STRATEGIST_MONTHLY_BUDGET_USD=60
STRATEGIST_MIN_REPORTS=2

# ---- Research worker (python -m app.workers.research_worker) ----
# Off by default. Turns the watcher's INVESTIGATE / REVIEW_POSITION jobs into one frozen
# evidence bundle each, analyzed by five specialist analysts (RESEARCH_MODEL).
RESEARCH_WORKER_ENABLED=false
RESEARCH_WORKER_INTERVAL_SECONDS=30
RESEARCH_BUNDLE_TTL_MINUTES=120
RESEARCH_DAILY_BUDGET_USD=5
RESEARCH_MONTHLY_BUDGET_USD=75

# ---- Market watcher (python -m app.workers.market_watcher) ----
# Off by default. Polls every WATCHER_INTERVAL_SECONDS (30-300) during market hours and sends
# only CHANGED symbols to WATCHER_MODEL, within daily/monthly estimated-cost ceilings.
WATCHER_ENABLED=false
WATCHER_INTERVAL_SECONDS=60
WATCHER_CLOSED_SLEEP_SECONDS=300
WATCHER_COOLDOWN_MINUTES=15
WATCHER_BATCH_SIZE=8
WATCHER_DAILY_BUDGET_USD=2
WATCHER_MONTHLY_BUDGET_USD=30
WATCHER_JOB_MAX_ATTEMPTS=3
WATCHER_JOB_LEASE_SECONDS=300
# Per-attempt timeout (seconds) and SDK retries for Claude requests.
LLM_TIMEOUT_SEC=300
LLM_MAX_RETRIES=2
# Re-run a safety refusal on Anthropic's recommended fallback model (not available for Haiku).
LLM_REFUSAL_FALLBACKS=true
# Fail closed: no actionable intents from market data older than this (seconds), no approval
# of intents older than this (minutes), and limit prices must be within this % of last price.
MAX_DATA_AGE_SEC=600
INTENT_MAX_AGE_MIN=60
MAX_LIMIT_DEVIATION_PCT=10

# ---- Alpaca ----
ALPACA_KEY=PKxxxxxxxxxxxxxxxxxx
ALPACA_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# paper (default) or live. KEEP THIS ON paper until fully tested.
TRADING_MODE=paper

# ---- Backend auth (shared bearer token the frontend sends) ----
API_TOKEN=change-me-to-a-long-random-string

# ---- Risk parameters (override defaults if you want tighter limits while testing) ----
DAILY_LOSS_LIMIT_PCT=10
MAX_POSITION_PCT=10
MAX_OPEN_POSITIONS=3
PENNY_STOCK_PRICE=5.00
MAX_INTRADAY_GAIN_PCT=50

# ---- Adaptive risk policies (can only SHRINK or REJECT a buy; never loosen the rules above) ----
# Equity at risk per trade: stop% x position% <= RISK_PER_TRADE_PCT. Size scales down when the
# ATR is above ATR_HIGH_PCT of the price; a cut below POLICY_MIN_SIZE_PCT becomes a rejection.
RISK_PER_TRADE_PCT=1.0
ATR_HIGH_PCT=4.0
POLICY_MIN_SIZE_PCT=0.25
# Portfolio caps (% of equity), counting open positions, open buy orders and earlier buys in
# the same analysis run. Note: MAX_OPEN_POSITIONS x MAX_POSITION_PCT above this cap means the
# exposure cap binds first.
MAX_GROSS_EXPOSURE_PCT=50
MAX_SECTOR_EXPOSURE_PCT=25
# Reject a buy highly correlated (daily returns) with MAX_CORRELATED_HOLDINGS or more holdings.
CORRELATION_THRESHOLD=0.85
CORRELATION_MIN_OBS=20
MAX_CORRELATED_HOLDINGS=2
# Liquidity: 20-day average daily dollar volume, and position size as % of it.
MIN_ADV_USD=1000000
MAX_PCT_OF_ADV=1.0
BLOCK_WHEN_MARKET_CLOSED=false

# ---- Autonomous trading (ALL DEFAULT OFF — manual approval is unchanged when off) ----
# An automated order needs BOTH this server capability AND the dashboard mode set to "Auto"
# (Manual / Observe / Auto), with the kill switch off. Observe mode records what automation
# would do without placing orders and does not need this capability.
# Master capability switch. Must be true for any autonomous execution.
AUTO_TRADING_ENABLED=false
# Required IN ADDITION to TRADING_MODE=live and AUTO_TRADING_ENABLED=true before any
# autonomous LIVE order. Must be exactly: I_UNDERSTAND_THE_RISK
AUTO_LIVE_TRADING_CONFIRMATION=
# Minimum Claude confidence (percent, 0-100) for an auto-buy/sell.
AUTO_MIN_CONFIDENCE=75
# Position-monitor poll interval in seconds (clamped to 60-300 = 1-5 minutes).
AUTO_MONITOR_INTERVAL_SEC=60

# ---- Continuous AI market monitor (rule-based triggers -> Claude). OFF by default. ----
CONTINUOUS_MONITOR_ENABLED=false
MONITOR_INTERVAL_SEC=60
AUTO_SELL_CONFIDENCE=65
AUTO_BUY_CONFIDENCE=50
# Max tickers monitored per cycle. 0 = no cap (monitor the entire watchlist). Higher
# values mean more market-data fetches per cycle — raise the interval if it can't keep up.
MONITOR_MAX_SYMBOLS=40

# ---- AI-managed exits (trailing stop + partial profit-taking + thesis re-eval) ----
AI_EXIT_CONFIDENCE=65
TRAILING_STOP_PERCENT=6
PARTIAL_PROFIT_LEVELS=5,10,15
PARTIAL_PROFIT_AMOUNTS=20,20,20
CONFIDENCE_RECHECK_INTERVAL=300
MAX_HOLD_DAYS=20

# ---- Prescreen + batching pipeline (large watchlists) ----
MAX_WATCHLIST_SIZE=500
PRESCREEN_TOP_N=30
CLAUDE_BATCH_SIZE=10
MAX_FINAL_RECOMMENDATIONS=30

# ---- Daily review (python -m app.services.review.run --date YYYY-MM-DD [--weekly]) ----
# Strategy-metric groups with fewer closed trades are stored but flagged insufficient.
REVIEW_MIN_SAMPLE_SIZE=20
# Lower edges of the confidence buckets used for calibration.
REVIEW_CONFIDENCE_BUCKETS=0.5,0.6,0.7,0.8,0.9
# Optional Claude summary of the aggregates (stored as proposals that need your approval).
REVIEW_LLM_SUMMARY=false

# ---- Market data layer ----
# "" = the account's default feed (IEX on free plans: partial volume); or iex | sip
ALPACA_DATA_FEED=
# Symbols per batched Alpaca request, and how many batched requests run in parallel.
DATA_CHUNK_SIZE=100
DATA_MAX_CONCURRENCY=4
# Daily-bar cache (seconds). Quotes older than MAX_QUOTE_AGE_SEC while the market is open
# are flagged stale, and buy/sell intents for that symbol are rejected.
BARS_CACHE_TTL_SEC=900
MAX_QUOTE_AGE_SEC=120
NEWS_LOOKBACK_HOURS=48
NEWS_PER_SYMBOL=5
# ETFs for the market-context block (index trend, sector breadth, volatility proxy).
MARKET_CONTEXT_SYMBOLS=SPY,QQQ,IWM,DIA,XLK,XLF,XLE,XLV,XLY,XLP,XLI,XLB,XLU,XLRE,XLC

# ---- Streaming worker (python -m app.workers.market_stream) ----
# Seconds between buffered DB writes, REST refills of missed minute bars (looking back at
# most STREAM_REFILL_MAX_MINUTES), watchlist/position symbol refreshes, and heartbeats.
STREAM_FLUSH_SEC=2
STREAM_REFILL_SEC=300
STREAM_REFILL_MAX_MINUTES=60
STREAM_SYMBOL_REFRESH_SEC=180
STREAM_HEARTBEAT_SEC=60

# ---- Research data (python -m app.services.research_data.refresh --symbols AAPL,MSFT) ----
# SEC EDGAR requires a descriptive User-Agent with your own contact details, e.g.
# "YourApp/1.0 you@example.com". Empty = EDGAR disabled (fundamentals labeled missing).
SEC_USER_AGENT=
# Hard-capped at 5 requests/second in code (SEC fair-access policy allows 10).
SEC_MAX_REQUESTS_PER_SEC=5
# Free key from https://fred.stlouisfed.org/docs/api/api_key.html. Empty = macro disabled.
FRED_API_KEY=
RESEARCH_HTTP_TIMEOUT_SEC=20

# ---- Optional data sources ----
NEWS_API_KEY=

# ---- Backtest reports (python -m app.backtest.ai_run / paper_report) ----
# Directory the report CLIs write to and GET /backtests/reports reads (relative to backend/).
BACKTEST_REPORT_DIR=reports

# ---- Operations (PR 10): health watcher, alerts, retention ----
# python -m app.workers.health_watcher (opt-in). Alerts go to system_alerts and GET /ops/alerts.
HEALTH_WATCHER_ENABLED=false
HEALTH_WATCHER_INTERVAL_SECONDS=60
OPS_HEARTBEAT_STALE_SEC=300
OPS_MARKET_DATA_STALE_SEC=300
OPS_ORDER_FAILURE_WINDOW_MIN=60
OPS_ORDER_FAILURE_THRESHOLD=3
# Warn at this % of a role's daily Claude budget; critical at 100%.
OPS_BUDGET_ALERT_PCT=80
OPS_RESEARCH_BACKLOG_THRESHOLD=25
OPS_RESEARCH_FAILED_THRESHOLD=3
OPS_RECONCILE_WINDOW_MIN=120
OPS_RECONCILE_MISMATCH_THRESHOLD=1
# true = alert when the market-stream worker's heartbeat goes stale (set it if you run the stream).
OPS_EXPECT_MARKET_STREAM=false
# python -m app.services.ops.retention [--apply]. Days to keep; 0 = keep forever.
RETENTION_SYSTEM_ALERTS_DAYS=0
RETENTION_WORKER_HEARTBEATS_DAYS=0
RETENTION_MARKET_BARS_DAYS=0
RETENTION_NEWS_EVENTS_DAYS=0
RETENTION_RESEARCH_JOBS_DAYS=0

# ---- Logging ----
LOG_LEVEL=INFO
# json (default) or text
LOG_FORMAT=json

# ---- CORS (frontend origin) ----
FRONTEND_ORIGIN=http://localhost:5173
