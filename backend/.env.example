# ---- Database ----
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/trading_assistant

# ---- Claude ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Model routing: one model + effort per layer (effort: low | medium | high | xhigh | max).
# strategist = trade analysis; position = monitor/position decisions (blank = strategist model).
STRATEGIST_MODEL=claude-opus-5-5
STRATEGIST_EFFORT=high
POSITION_MODEL=
POSITION_EFFORT=medium
RESEARCH_MODEL=claude-sonnet-5-5
RESEARCH_EFFORT=medium
WATCHER_MODEL=claude-haiku-5-5
WATCHER_EFFORT=low
# Per-attempt timeout (seconds) and SDK retries for Claude requests.
LLM_TIMEOUT_SEC=300
LLM_MAX_RETRIES=2
# Re-run a safety refusal on Anthropic's recommended fallback model (not available for Haiku).
LLM_REFUSAL_FALLBACKS=true
# Fail closed: no actionable intents from market data older than this (seconds), no approval
# of intents older than this (minutes), and limit prices must be within this % of last price.
MAX_DATA_AGE_SEC=600
INTENT_MAX_AGE_MIN=60
MAX_LIMIT_DEVIATION_PCT=10

# ---- Alpaca ----
ALPACA_KEY=PKxxxxxxxxxxxxxxxxxx
ALPACA_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# paper (default) or live. KEEP THIS ON paper until fully tested.
TRADING_MODE=paper

# ---- Backend auth (shared bearer token the frontend sends) ----
API_TOKEN=change-me-to-a-long-random-string

# ---- Risk parameters (override defaults if you want tighter limits while testing) ----
DAILY_LOSS_LIMIT_PCT=10
MAX_POSITION_PCT=10
MAX_OPEN_POSITIONS=3
PENNY_STOCK_PRICE=5.00
MAX_INTRADAY_GAIN_PCT=50

# ---- Autonomous trading (ALL DEFAULT OFF — manual approval is unchanged when off) ----
# An automated order needs BOTH this server capability AND the dashboard mode set to "Auto"
# (Manual / Observe / Auto), with the kill switch off. Observe mode records what automation
# would do without placing orders and does not need this capability.
# Master capability switch. Must be true for any autonomous execution.
AUTO_TRADING_ENABLED=false
# Required IN ADDITION to TRADING_MODE=live and AUTO_TRADING_ENABLED=true before any
# autonomous LIVE order. Must be exactly: I_UNDERSTAND_THE_RISK
AUTO_LIVE_TRADING_CONFIRMATION=
# Minimum Claude confidence (percent, 0-100) for an auto-buy/sell.
AUTO_MIN_CONFIDENCE=75
# Position-monitor poll interval in seconds (clamped to 60-300 = 1-5 minutes).
AUTO_MONITOR_INTERVAL_SEC=60

# ---- Continuous AI market monitor (rule-based triggers -> Claude). OFF by default. ----
CONTINUOUS_MONITOR_ENABLED=false
MONITOR_INTERVAL_SEC=60
AUTO_SELL_CONFIDENCE=65
AUTO_BUY_CONFIDENCE=50
# Max tickers monitored per cycle. 0 = no cap (monitor the entire watchlist). Higher
# values mean more market-data fetches per cycle — raise the interval if it can't keep up.
MONITOR_MAX_SYMBOLS=40

# ---- AI-managed exits (trailing stop + partial profit-taking + thesis re-eval) ----
AI_EXIT_CONFIDENCE=65
TRAILING_STOP_PERCENT=6
PARTIAL_PROFIT_LEVELS=5,10,15
PARTIAL_PROFIT_AMOUNTS=20,20,20
CONFIDENCE_RECHECK_INTERVAL=300
MAX_HOLD_DAYS=20

# ---- Prescreen + batching pipeline (large watchlists) ----
MAX_WATCHLIST_SIZE=500
PRESCREEN_TOP_N=30
CLAUDE_BATCH_SIZE=10
MAX_FINAL_RECOMMENDATIONS=30

# ---- Optional data sources ----
NEWS_API_KEY=

# ---- Logging ----
LOG_LEVEL=INFO
# json (default) or text
LOG_FORMAT=json

# ---- CORS (frontend origin) ----
FRONTEND_ORIGIN=http://localhost:5173
